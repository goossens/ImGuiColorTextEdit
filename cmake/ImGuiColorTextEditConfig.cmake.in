@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT TARGET imgui::imgui AND NOT TARGET imgui)
    find_dependency(imgui CONFIG)
endif()
if(TARGET imgui AND NOT TARGET imgui::imgui)
    add_library(imgui::imgui ALIAS imgui)
endif()
if(NOT TARGET imgui::imgui AND NOT TARGET imgui)
    add_library(imgui::imgui INTERFACE IMPORTED)
    set_target_properties(imgui::imgui PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${imgui_INCLUDE_DIRS}"
        INTERFACE_LINK_LIBRARIES "${imgui_LIBRARIES}")
endif()
if(imgui_INCLUDE_DIRS)
    get_target_property(_imgui_real_target imgui::imgui ALIASED_TARGET)
    if(NOT _imgui_real_target)
        set(_imgui_real_target imgui::imgui)
    endif()
    get_target_property(_imgui_includes ${_imgui_real_target} INTERFACE_INCLUDE_DIRECTORIES)
    if(NOT _imgui_includes)
        set_property(TARGET ${_imgui_real_target} APPEND PROPERTY
            INTERFACE_INCLUDE_DIRECTORIES "${imgui_INCLUDE_DIRS}")
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ImGuiColorTextEdit-targets.cmake")
# Keep compatibility with ALT's original variable-based package interface.
set(ImGuiColorTextEdit_LIBRARIES ImGuiColorTextEdit::ImGuiColorTextEdit)
get_target_property(ImGuiColorTextEdit_INCLUDE_DIRS
    ImGuiColorTextEdit::ImGuiColorTextEdit INTERFACE_INCLUDE_DIRECTORIES)
set(ImGuiColorTextEdit_GEOGRAM_ENABLED @ENABLE_GEOGRAM@)
set(ImGuiColorTextEdit_BALAZS_ENABLED @ENABLE_BALAZS@)
check_required_components(ImGuiColorTextEdit)
